rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isAdmin() && (
        (request.resource.data.keys().hasOnly(['deleted']) && request.resource.data.deleted == true)
        || (request.resource.data.keys().hasOnly(['title', 'type', 'badge', 'date', 'description', 'longDescription', 'tech', 'image', 'isNew', 'order', 'links', 'deleted'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.type in ['web', 'design', 'vlog']
          && request.resource.data.badge is map
          && request.resource.data.date is map
          && request.resource.data.description is map
          && request.resource.data.longDescription is map
          && request.resource.data.tech is list
          && request.resource.data.image is string
          && request.resource.data.isNew is bool
          && request.resource.data.order is number
          && request.resource.data.links is list
          && request.resource.data.deleted == false)
      );
      allow delete: if isAdmin();
    }
  }
}
